FROM `products` `pr`
LEFT JOIN `product_category` `pc` ON `pc`.`product_category_id` = `pr`.`product_category`
LEFT JOIN `product_group` `pg` ON `pg`.`product_group_id` = `pr`.`product_group`
LEFT JOIN `product_brand` `pb` ON `pb`.`brand_id` = `pr`.`product_brand`
LEFT JOIN `product_unit` `pu` ON `pu`.`product_unit_id` = `pr`.`product_unit`
LEFT JOIN `product_strength` `ps` ON `ps`.`strength_id` = `pr`.`product_strength`
LEFT JOIN product_opening_stock pos ON pos.product_id = pr.product_id
             AND pos.status = "active"
LEFT JOIN (
                SELECT ppd.*
                FROM product_purchase_details ppd

                INNER JOIN (
                    SELECT
                        ppd2.product_id,
                        MAX(ppd2.purchase_details_id)
                            AS latest_purchase_details_id

                    FROM product_purchase_details ppd2

                    INNER JOIN product_purchase pp2
                        ON pp2.purchase_id = ppd2.purchase_id

                    WHERE pp2.status = "active"

                    GROUP BY ppd2.product_id

                ) latest

                    ON latest.latest_purchase_details_id
                       = ppd.purchase_details_id

            ) lp ON lp.product_id = pr.product_id
