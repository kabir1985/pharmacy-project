                            SELECT 
                                sales_details_invoice, 
                                SUM(total_sale_price) AS total_sale, 
                                SUM(tax_paid) AS total_tax
                            FROM sales_details
                            GROUP BY sales_details_invoice
                        ) sd ON s.sales_invoice = sd.sales_details_invoice
