                                ELSE s.customer_type
                            END AS customer_name,
                            CASE
                                WHEN s.customer_type = \'Walk-In-Customer\' THEN \'Fully Paid\'
                                WHEN IFNULL(cd.customer_due, 0) = 0 THEN \'Fully Paid\'
                                ELSE \'Partially Paid\'
                            END AS payment_status
                        FROM sales s
