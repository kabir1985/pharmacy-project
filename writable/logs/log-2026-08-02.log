            GROUP BY product_id
    
        ) sd_data
            ON pis.product_id = sd_data.product_id
    
        -- ================= SALES RETURN =================
        LEFT JOIN
        (
            SELECT
                product_id,
                SUM(return_qty) AS totalReturn
    
            FROM return_sales_details
    
            GROUP BY product_id
    
        ) rs_data
            ON pis.product_id = rs_data.product_id
    
        -- ================= STOCK ADJUSTMENT =================
