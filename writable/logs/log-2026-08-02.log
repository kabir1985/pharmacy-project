                - IFNULL(sd_data.totalSale,0)
                - IFNULL(adj.totalStockOut,0)
            ,0) AS current_stock
    
        FROM product_inital_stock AS pis
    
        LEFT JOIN tax tx
            ON pis.tax_id = tx.tax_id
    
        -- ================= PURCHASE =================
        LEFT JOIN
        (
            SELECT
    
                ppd.product_id,
    
                SUM(
