                ) AS totalPurchase,
    
                MAX(pp.purchaser_id) AS purchaser_id
    
            FROM product_purchase_details ppd
    
            LEFT JOIN product_purchase pp
                ON pp.purchase_invoice = ppd.purchase_invoice_id
    
            GROUP BY ppd.product_id
    
        ) ppd_data
