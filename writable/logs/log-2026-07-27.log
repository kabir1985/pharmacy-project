            SUM(payment_amount) total_paid
        FROM customer_due_payment
        GROUP BY sales_id
    ) cdp
    ON cdp.sales_id=s.sales_id
    
    WHERE s.return_status<>\'FULL\'
    
    ORDER BY s.sales_date DESC')
