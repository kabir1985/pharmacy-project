        LEFT JOIN (
            SELECT product_id, SUM(qty_in) qty
            FROM stock_ledger
            WHERE transaction_type=\'OPENING\'
            GROUP BY product_id
        ) opening
            ON opening.product_id = p.product_id

        LEFT JOIN (
            SELECT product_id, SUM(qty_in) qty
