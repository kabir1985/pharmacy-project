                ELSE 0
            END,

            0

        ) AS profit_margin_percent,


        /* =========================================
           SELLING PRICE
           
           Opening Stock:
           pos.selling_price

           Latest Purchase:
           lp.selling_price
        ========================================= */

        COALESCE(
            NULLIF(pos.selling_price, 0),
            NULLIF(lp.selling_price, 0),
            0
        ) AS selling_price,


